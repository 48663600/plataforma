PORT=3000

# Secreto para firmar sesiones (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# PostgreSQL (p. ej. Supabase → Project Settings → Database → Connection string).
# Si se deja vacío, los datos se guardan en backend/data/state.json (solo desarrollo).
DATABASE_URL=

# Orígenes permitidos para CORS, separados por comas (vacío = todos).
# Ej.: CORS_ORIGIN=https://48663600.github.io,http://localhost:5173
CORS_ORIGIN=
